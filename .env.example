# =============================================================================
# AnesthAI-SafeDose Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit .env with real credentials to source control.
# =============================================================================

# --- Backend Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Clinical Datasets Access ---
# Set to 'true' if credentialed PhysioNet MIMIC-IV full database is mounted locally
MIMIC_IV_CREDENTIALED=false

# --- Frontend Application Configuration (Vite) ---
# Base URL pointing to the FastAPI backend service
VITE_API_URL=http://localhost:8000
